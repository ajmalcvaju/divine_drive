rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Cars collection: Public can read published cars, only admins can write/delete
    match /cars/{carId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Gallery collection: Public can read published items, only admins can write
    match /gallery/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Enquiries collection: Public can submit new leads, only admins can view/update
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.customerName != null && request.resource.data.phone != null;
      allow read, update, delete: if isAdmin();
    }

    // Settings collection: Public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin records: Admin only
    match /admins/{adminUid} {
      allow read, write: if isAdmin();
    }
  }
}
