rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for vehicle & gallery media
    match /cars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
